# Copy to .env and fill in. Never commit real values.

# Data centre your mailbox lives in. Check the URL after signing in to Zoho Mail.
ZOHOMAIL_API_BASE=https://mail.zoho.com
ZOHOMAIL_ACCOUNTS_BASE=https://accounts.zoho.com

# From Zoho Console > Auth > Global Clients (or a Self Client).
# Required scopes: ZohoMail.messages.READ, ZohoMail.messages.CREATE,
# ZohoMail.accounts.READ, ZohoMail.folders.READ, ZohoMail.folders.CREATE
ZOHOMAIL_CLIENT_ID=
ZOHOMAIL_CLIENT_SECRET=
ZOHOMAIL_REFRESH_TOKEN=

# Optional: skips the account lookup on every call.
ZOHOMAIL_DEFAULT_ACCOUNT_ID=

# Bind address for the streamable HTTP endpoint (behind a TLS proxy / PaaS).
MCP_HOST=0.0.0.0
MCP_PORT=8080
